        "/v1/candles": {
            "get": {
                "operationId": "candles",
                "summary": "OHLC candles (UTC), oldest first. M1 gives every stored minute (only closed minutes are stored). M5 and higher give only closed candles: the running candle is left out until its period has ended (at 12:23 the newest M5 candle is the one of 12:15; 12:20 arrives complete after 12:25). Without date: the most recent candles; with date: that UTC day (within your plan's history). Brokers give no real volume, so volume is an activity score: the candle's range (60 %) and body (40 %) against the average of the 20 candles before it, x100 (100 = normal, 0 when fewer than 20 earlier candles). payout = the broker's payout % when the candle opened.",
                "tags": [
                    "Candles (OHLC)"
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Success"
                                },
                                "example": {
                                    "ok": true,
                                    "data": {
                                        "broker": "quotex",
                                        "symbol": "EURUSD_otc",
                                        "timeframe": "M1",
                                        "candles": [
                                            {
                                                "time": "2026-10-05T07:27:00Z",
                                                "chart_open": true,
                                                "epoch": 1791185220,
                                                "open": 17800.91,
                                                "high": 17801.26,
                                                "low": 17799.7,
                                                "close": 17800.03,
                                                "payout": 89,
                                                "volume": 87
                                            },
                                            {
                                                "time": "2026-10-05T07:28:00Z",
                                                "chart_open": true,
                                                "epoch": 1791185280,
                                                "open": 17800.03,
                                                "high": 17800.08,
                                                "low": 17798.43,
                                                "close": 17798.6,
                                                "payout": 89,
                                                "volume": 124
                                            }
                                        ]
                                    },
                                    "meta": {
                                        "request_id": "req_01J…"
                                    }
                                }
                            }
                        }
                    },
                    "default": {
                        "description": "Error (see the error codes)",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Error"
                                }
                            }
                        }
                    }
                },
                "security": [
                    {
                        "apiKey": []
                    },
                    {
                        "apiKeyQuery": []
                    }
                ],
                "x-quantex-scope": "candles:read",
                "x-quantex-group": "candles",
                "parameters": [
                    {
                        "name": "broker",
                        "in": "query",
                        "required": false,
                        "description": "Broker: quotex, tradowix or binolla (the ones your plan covers: Candle Basic 1, Candle Data 2, Full Market Data all 3; otherwise error broker_not_in_plan).",
                        "schema": {
                            "type": "string",
                            "enum": [
                                "quotex",
                                "tradowix",
                                "binolla"
                            ],
                            "default": "quotex"
                        }
                    },
                    {
                        "name": "pair",
                        "in": "query",
                        "required": true,
                        "description": "Pair symbol from /v1/pairs, e.g. EURUSD_otc.",
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "tf",
                        "in": "query",
                        "required": false,
                        "description": "Timeframe.",
                        "schema": {
                            "type": "string",
                            "enum": [
                                "M1",
                                "M5",
                                "M15",
                                "M30",
                                "H1",
                                "H4"
                            ],
                            "default": "M1"
                        }
                    },
                    {
                        "name": "limit",
                        "in": "query",
                        "required": false,
                        "description": "Number of candles (newest last). Without date: 1-2000 (Market Data plans; 1-1000 on other plans), default 100. With date: 1-1440, default the whole day (M1: 1440 candles).",
                        "schema": {
                            "type": "integer",
                            "default": 100
                        }
                    },
                    {
                        "name": "date",
                        "in": "query",
                        "required": false,
                        "description": "UTC day, YYYY-MM-DD.",
                        "schema": {
                            "type": "string"
