        "/v1/ticks": {
            "get": {
                "operationId": "ticks",
                "summary": "The newest live tick of up to 20 pairs (QUOTEX, TRADOWIX and BINOLLA): price, bid, ask and the exact time in milliseconds (UTC), plus the broker's running M1 candle (open, high, low, close = price, seconds_left). Put it on top of /v1/candles and your chart moves exactly like the broker's. fresh=false: no new tick for 2 minutes (market closed or paused). available=false: no tick for this pair right now. For a moving chart use the tick stream (/v1/stream/ticks) instead of asking again and again.",
                "tags": [
                    "Live ticks"
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
