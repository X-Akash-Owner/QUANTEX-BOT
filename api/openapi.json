{
    "openapi": "3.1.0",
    "info": {
        "title": "QUANTEX Developer API",
        "version": "v1",
        "description": "QUANTEX Developer API: Brokers & pairs, Payouts, Account & usage, Candles (OHLC), Historical candles, Live ticks. Every answer uses the envelope {\"ok\", \"data\" | \"error\", \"meta\"}. Binary options trading carries high risk; data is analysis, not a guarantee.",
        "contact": {
            "url": "https://quantexbot.pro/contact"
        }
    },
    "servers": [
        {
            "url": "https://api.quantexbot.pro"
        }
    ],
    "paths": {
        "/v1/status": {
            "get": {
                "operationId": "status",
                "summary": "Status of the API, data feeds, Telegram bot and payments, and open incidents (the same as quantexbot.pro/status). status: operational, degraded, partial_outage, major_outage or maintenance; each component: operational, degraded, down or unknown. No key needed.",
                "tags": [
                    "Public"
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Success"
                                },
                                "example": {
                                    "ok": true,
                                    "data": {
                                        "status": "operational",
                                        "api_version": "v1",
                                        "server_time": "2026-10-05T10:00:00Z",
                                        "components": {
                                            "api": "operational",
                                            "market_data": "operational",
                                            "website": "operational",
                                            "telegram_bot": "operational",
                                            "payments": "operational"
                                        },
                                        "incidents": [],
                                        "page": "https://quantexbot.pro/status"
                                    },
                                    "meta": {
                                        "request_id": "req_01J…"
                                    }
                                }
                            }
                        }
                    },
                    "default": {
                        "description": "Error (see the error codes)",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Error"
                                }
                            }
                        }
                    }
                },
                "security": []
            }
        },
