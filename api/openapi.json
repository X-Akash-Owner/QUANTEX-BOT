        "/v1/stream/ticks": {
            "get": {
                "operationId": "tick_stream",
                "summary": "Server-Sent Events: a \"tick\" event (same object as in /v1/ticks) every time the price of one of your pairs changes, checked about 4 times a second. When a minute closes the next tick carries the new candle, so a chart fed by this stream draws every candle like the broker. The stream closes after 5 minutes with event \"reconnect\"; open it again (EventSource does this by itself). At most 2 open streams per account.",
                "tags": [
                    "Live ticks"
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "text/event-stream": {
                                "schema": {
                                    "type": "string",
                                    "description": "Server-Sent Events: event = tick, data = one tick as JSON (see /v1/ticks)."
                                }
                            }
                        }
                    },
                    "default": {
                        "description": "Error (see the error codes)",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Error"
                                }
                            }
                        }
                    }
                },
                "security": [
